{
  "name": "testing-dashboard",
  "description": "Local-first orbital mission dashboard with SQLite replication and GMAT.",
  "author": "NCKU Runspace 2026",
  "private": true,
  "version": "0.2.18",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:electron": "node --test electron/main/configStore.test.cjs electron/main/gmatRunner.test.cjs electron/main/scriptGenerator.test.cjs electron/main/localBackend.test.cjs electron/main/appUpdater.test.cjs",
    "smoke:renderer": "node scripts/run_packaged_renderer_smoke.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && node scripts/start_electron_dev.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "bash scripts/build_macos_release.sh",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.6",
    "@astryxdesign/theme-neutral": "^0.1.6",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.74.0",
    "tslib": "^2.8.1",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "org.nckurunspace.tasa.missiondashboard",
    "productName": "Mission Dashboard",
    "icon": "public/Team-Logo.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/mission-dashboard-backend",
        "to": "backend"
      },
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NCKURunspace2026",
        "repo": "tasa-main-program"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "Mission-Dashboard-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Mission-Dashboard-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
